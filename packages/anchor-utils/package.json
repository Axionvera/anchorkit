{
  "name": "@anchorkit/anchor-utils",
  "version": "0.1.0",
  "private": false,
  "description": "AnchorKit SEP-style anchor flow utilities: deposit/withdrawal metadata, anchor transaction statuses, and mock fixtures",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anchorkit/types": "workspace:*",
    "@anchorkit/config": "workspace:*",
    "@anchorkit/validators": "workspace:*",
    "@anchorkit/stellar-kit": "workspace:*",
    "@anchorkit/fixtures": "workspace:*",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
