{
  "name": "@anchorkit/integration-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-package integration tests for AnchorKit public APIs and shared fixtures",
  "scripts": {
    "lint": "eslint \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@anchorkit/anchor-utils": "workspace:*",
    "@anchorkit/config": "workspace:*",
    "@anchorkit/fixtures": "workspace:*",
    "@anchorkit/stellar-kit": "workspace:*",
    "@anchorkit/types": "workspace:*",
    "@anchorkit/validators": "workspace:*",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
